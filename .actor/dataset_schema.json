                "fields": [
                    "date",
                    "copperGoldRatio",
                    "ratioPercentile",
                    "actual10yYieldPct",
                    "implied10yYieldPct",
                    "residualBp",
                    "termPremiumStatus",
                    "actual30yYieldPct",
                    "goldPriceUsd",
                    "copperPriceUsd",
                    "goldBeta30y",
                    "corr60d",
                    "macroRegimeSignal"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "date": {
                        "label": "Date",
                        "format": "text"
                    },
                    "copperGoldRatio": {
                        "label": "Cu/Au Ratio",
                        "format": "number"
                    },
                    "ratioPercentile": {
                        "label": "Ratio %ile",
                        "format": "number"
                    },
                    "actual10yYieldPct": {
